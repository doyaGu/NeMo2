# CI may restrict test-only edits to the executables whose sources changed.
# Targets remain available explicitly; ordinary builds retain the existing defaults.
set(NEMO_TEST_TARGET_FILTER "" CACHE STRING "Test source directories and selected executable targets")

function(nemo_filter_test_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach (target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if (NOT type STREQUAL "EXECUTABLE")
            continue()
        endif ()
        get_target_property(source ${target} SOURCE_DIR)
        foreach (filter IN LISTS NEMO_TEST_TARGET_FILTER)
            string(REPLACE "=" ";" parts "${filter}")
            list(GET parts 0 prefix)
            list(GET parts 1 allowed)
            set(prefix "${PROJECT_SOURCE_DIR}/${prefix}")
            cmake_path(IS_PREFIX prefix "${source}" NORMALIZE owned)
            string(REPLACE "|" ";" allowed "${allowed}")
            if (owned AND NOT target IN_LIST allowed)
                set_property(TARGET ${target} PROPERTY EXCLUDE_FROM_ALL TRUE)
            endif ()
        endforeach ()
    endforeach ()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach (child IN LISTS children)
        nemo_filter_test_targets("${child}")
    endforeach ()
endfunction()

if (NEMO_TEST_TARGET_FILTER)
    nemo_filter_test_targets("${CMAKE_CURRENT_SOURCE_DIR}/Source")
endif ()
