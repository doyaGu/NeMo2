# Shared module catalogue and explicit module selection for the aggregator.
include_guard(GLOBAL)

set(_nemo_core_modules VxMath CK2)
set(_nemo_render_modules CK2_3D CKSdlGpuRasterizer)
set(_nemo_manager_modules SdlInputManager SdlSoundManager ParameterOperations)
set(_nemo_plugin_modules AVIReader ImageReader WavReader VirtoolsLoader)
set(_nemo_bb_modules
        3DTrans BuildingBlocksAddons1 Cameras Characters Collision Controllers
        Grids Interface Lights Logics Materials MeshModifiers MidiManager Narratives
        Sounds Visuals WorldEnvironment physics_RT TT_DatabaseManager_RT
        TT_Gravity_RT TT_InterfaceManager_RT TT_ParticleSystems_RT TT_Toolbox_RT)
set(_nemo_all_modules ${_nemo_core_modules} ${_nemo_render_modules}
        ${_nemo_manager_modules} ${_nemo_plugin_modules} ${_nemo_bb_modules})

if (NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${CMAKE_CURRENT_LIST_DIR}/NeMo2ModuleDependencies.json")
endif ()
file(READ "${CMAKE_CURRENT_LIST_DIR}/NeMo2ModuleDependencies.json" _nemo_runtime_dependencies)

function(nemo_module_dependencies module result)
    string(JSON dependencies ERROR_VARIABLE missing GET "${_nemo_runtime_dependencies}" "${module}")
    set(values)
    if (NOT missing)
        string(JSON count LENGTH "${dependencies}")
        if (count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach (index RANGE ${last})
                string(JSON dependency GET "${dependencies}" ${index})
                list(APPEND values "${dependency}")
            endforeach ()
        endif ()
    endif ()
    set(${result} "${values}" PARENT_SCOPE)
endfunction()

function(nemo_visit_module module trail result)
    if (NOT module IN_LIST _nemo_all_modules)
        message(FATAL_ERROR "Unknown NEMO_MODULES entry '${module}'. Available modules: ${_nemo_all_modules}")
    endif ()
    if (module STREQUAL "MidiManager" AND NOT WIN32)
        message(FATAL_ERROR "NEMO_MODULES: MidiManager is supported only on Windows")
    endif ()
    if (module IN_LIST trail)
        message(FATAL_ERROR "Cyclic NeMo2 module dependency: ${trail};${module}")
    endif ()
    list(APPEND trail "${module}")
    nemo_module_dependencies("${module}" dependencies)
    set(resolved)
    foreach (dependency IN LISTS dependencies)
        nemo_visit_module("${dependency}" "${trail}" children)
        list(APPEND resolved ${children})
    endforeach ()
    list(APPEND resolved "${module}")
    set(${result} "${resolved}" PARENT_SCOPE)
endfunction()

function(nemo_resolve_modules requested result)
    if (requested STREQUAL "ALL")
        set(modules ${_nemo_all_modules})
        if (NOT WIN32)
            list(REMOVE_ITEM modules MidiManager)
        endif ()
    elseif (requested STREQUAL "NONE" OR requested STREQUAL "")
        set(modules ${_nemo_core_modules})
    else ()
        set(modules ${_nemo_core_modules} ${requested})
    endif ()
    set(resolved)
    foreach (module IN LISTS modules)
        nemo_visit_module("${module}" "" dependencies)
        list(APPEND resolved ${dependencies})
    endforeach ()
    list(REMOVE_DUPLICATES resolved)
    set(${result} "${resolved}" PARENT_SCOPE)
endfunction()

function(nemo_configure_modules)
    set(NEMO_MODULES "AUTO" CACHE STRING "AUTO: existing module options; ALL: available modules; NONE: core only; or a semicolon-separated target list")
    set_property(CACHE NEMO_MODULES PROPERTY STRINGS AUTO ALL NONE)
    foreach (group RENDER_ENGINE MANAGERS PLUGINS BUILDING_BLOCKS)
        set(_NEMO_WITH_${group} ON PARENT_SCOPE)
    endforeach ()
    set(NEMO_MODULE_SELECTION_EXPLICIT OFF PARENT_SCOPE)
    if (NEMO_MODULES STREQUAL "AUTO")
        return()
    endif ()
    nemo_resolve_modules("${NEMO_MODULES}" modules)
    set(NEMO_MODULE_SELECTION_EXPLICIT ON PARENT_SCOPE)
    set(NEMO_SELECTED_MODULES "${modules}" PARENT_SCOPE)
    foreach (pair "RENDER_ENGINE|render" "MANAGERS|manager" "PLUGINS|plugin" "BUILDING_BLOCKS|bb")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 group)
        list(GET pair 1 catalogue)
        set(enabled OFF)
        foreach (module IN LISTS _nemo_${catalogue}_modules)
            if (module IN_LIST modules)
                set(enabled ON)
            endif ()
        endforeach ()
        set(_NEMO_WITH_${group} "${enabled}" PARENT_SCOPE)
    endforeach ()
    # Normal variables shadow module-enable cache entries for this configuration
    # only. Returning to AUTO restores the caller's existing granular options.
    set(CKRE_BUILD_SDL_GPU_RASTERIZER OFF PARENT_SCOPE)
    if ("CKSdlGpuRasterizer" IN_LIST modules)
        set(CKRE_BUILD_SDL_GPU_RASTERIZER ON PARENT_SCOPE)
    endif ()
    set(CKMANAGERS_BUILD_ALL OFF PARENT_SCOPE)
    foreach (pair "SdlInputManager|SDLINPUT" "SdlSoundManager|SDLSOUND" "ParameterOperations|PARAMETEROPERATIONS")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 module)
        list(GET pair 1 option)
        set(enabled OFF)
        if (module IN_LIST modules)
            set(enabled ON)
        endif ()
        set(CKMANAGERS_BUILD_${option} "${enabled}" PARENT_SCOPE)
    endforeach ()
    foreach (module IN LISTS _nemo_plugin_modules)
        string(TOUPPER "${module}" option)
        set(enabled OFF)
        if (module IN_LIST modules)
            set(enabled ON)
        endif ()
        set(CKPLUGINS_BUILD_${option} "${enabled}" PARENT_SCOPE)
    endforeach ()
    set(CKBB_BUILD_ALL_MODULES OFF PARENT_SCOPE)
    foreach (module IN LISTS _nemo_bb_modules)
        set(option "${module}")
        if (module STREQUAL "Materials")
            set(option Materials-Textures)
        endif ()
        set(enabled OFF)
        if (module IN_LIST modules)
            set(enabled ON)
        endif ()
        set(CKBB_BUILD_${option} "${enabled}" PARENT_SCOPE)
    endforeach ()
    message(STATUS "[NeMo2] Selected modules: ${modules}")
endfunction()
