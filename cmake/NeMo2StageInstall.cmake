cmake_minimum_required(VERSION 3.25)

if (NOT EXISTS "${NEMO_STAGE_BUILD_DIR}/CMakeCache.txt")
    message(FATAL_ERROR "Stage requires a configured build directory")
endif ()
file(REAL_PATH "${NEMO_STAGE_BUILD_DIR}" build)
file(LOCK "${build}/.nemo-stage.lock" GUARD PROCESS TIMEOUT 60)
set(stage "${build}/stage")
if (IS_SYMLINK "${stage}" OR (EXISTS "${stage}" AND NOT IS_DIRECTORY "${stage}"))
    message(FATAL_ERROR "Stage destination must be a directory, not a file or symlink: ${stage}")
endif ()

# Only the build-local stage is owned by this target. A normal cmake --install
# retains the caller's install prefix and additive installation semantics.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(snapshot "${build}/.nemo-stage-${id}")
set(backup "${build}/.nemo-stage-previous-${id}")
file(MAKE_DIRECTORY "${snapshot}")
foreach (component Runtime Development)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DESTDIR
            "${CMAKE_COMMAND}" --install "${build}" --config "${NEMO_STAGE_CONFIG}"
            --prefix "${snapshot}" --component "${component}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (NOT result EQUAL 0)
        file(REMOVE_RECURSE "${snapshot}")
        message(FATAL_ERROR "Stage installation failed; previous stage preserved:\n${output}${error}")
    endif ()
endforeach ()
if (EXISTS "${stage}")
    file(RENAME "${stage}" "${backup}" RESULT result)
    if (NOT result STREQUAL "0")
        file(REMOVE_RECURSE "${snapshot}")
        message(FATAL_ERROR "Cannot move previous stage: ${result}")
    endif ()
endif ()
file(RENAME "${snapshot}" "${stage}" RESULT result)
if (NOT result STREQUAL "0")
    if (EXISTS "${backup}")
        file(RENAME "${backup}" "${stage}")
    endif ()
    file(REMOVE_RECURSE "${snapshot}")
    message(FATAL_ERROR "Cannot publish stage: ${result}")
endif ()
file(REMOVE_RECURSE "${backup}")
message(STATUS "Staged NeMo2 to ${stage}")
