find_package(Git REQUIRED)

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(fixture "${TEST_BINARY_DIR}/numerical-isolation-${fixture_id}")
file(MAKE_DIRECTORY "${fixture}")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${fixture}" init --quiet
        --initial-branch=codex/isolation-test COMMAND_ERROR_IS_FATAL ANY)

function(check_isolation path source allowed)
    get_filename_component(directory "${fixture}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${fixture}/${path}" "${source}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${fixture}" add -- "${path}"
            COMMAND_ERROR_IS_FATAL ANY)
    set(engine_source_dir "${fixture}")
    if (ARGC GREATER 3)
        set(engine_source_dir "${fixture}/${ARGV3}")
    endif ()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_SOURCE_DIR=${fixture}"
            "-DTEST_ENGINE_SOURCE_DIR=${engine_source_dir}"
            -P "${TEST_SOURCE_DIR}/cmake/TestNumericalIsolation.cmake"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if ((allowed AND NOT result EQUAL 0) OR (NOT allowed AND result EQUAL 0))
        message(FATAL_ERROR "Unexpected ownership result for ${path}:\n${output}${error}")
    endif ()
    if (NOT allowed)
        string(FIND "${error}" "Numerical backend details escaped their owning libraries" reason)
        string(FIND "${error}" "${path}" location)
        if (reason LESS 0 OR location LESS 0)
            message(FATAL_ERROR "Ownership case failed for an unrelated reason:\n${output}${error}")
        endif ()
    endif ()
    file(WRITE "${fixture}/${path}" "")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${fixture}" add -- "${path}"
            COMMAND_ERROR_IS_FATAL ANY)
endfunction()

