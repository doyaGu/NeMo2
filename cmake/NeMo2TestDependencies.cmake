function(nemo_bb_test_dependencies result)
    if (NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/NeMo2BBTestDependencies.json")
    endif ()
    set(dependencies)
    if (CKBB_BUILD_TESTS AND (NOT DEFINED BUILD_TESTING OR BUILD_TESTING))
        file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/NeMo2BBTestDependencies.json" modules)
        string(JSON count LENGTH "${modules}")
        if (count EQUAL 0)
            set(${result} "" PARENT_SCOPE)
            return()
        endif ()
        math(EXPR last "${count} - 1")
        foreach (index RANGE ${last})
            string(JSON name MEMBER "${modules}" ${index})
            if (NEMO_MODULE_SELECTION_EXPLICIT AND NOT name IN_LIST NEMO_SELECTED_MODULES)
                continue()
            endif ()
            if (CKBB_TEST_MODULES AND NOT name IN_LIST CKBB_TEST_MODULES)
                continue()
            endif ()
            string(JSON length LENGTH "${modules}" "${name}")
            if (length EQUAL 0)
                continue()
            endif ()
            math(EXPR end "${length} - 1")
            foreach (item RANGE ${end})
                string(JSON dependency GET "${modules}" "${name}" ${item})
                list(APPEND dependencies "${dependency}")
            endforeach ()
        endforeach ()
    endif ()
    list(REMOVE_DUPLICATES dependencies)
    set(${result} "${dependencies}" PARENT_SCOPE)
endfunction()
