# Aggregator defaults; module-specific cache values remain authoritative.
option(NEMO_BUILD_STATIC "Build Virtools libraries and modules statically" OFF)
option(NEMO_BUILD_TESTS "Build the complete engine test suite" OFF)
set(NEMO_TARGET_ARCH "" CACHE STRING "Optional target architecture label")
include(NeMo2Modules)
nemo_configure_modules()
nemo_set_cache_default(CKMANAGERS_TARGET_ARCH "${NEMO_TARGET_ARCH}" STRING "Manager target architecture")
set(_nemo_ivp_tests ${NEMO_BUILD_TESTS})
if (NEMO_MODULE_SELECTION_EXPLICIT AND NOT "physics_RT" IN_LIST NEMO_SELECTED_MODULES)
    set(_nemo_ivp_tests OFF)
endif ()
nemo_set_cache_default(IVP_BUILD_TESTS ${_nemo_ivp_tests} BOOL "Build IVP tests")

find_package(SDL3 3.4.20 CONFIG REQUIRED)

foreach (_component IN ITEMS VXMATH CK2 CKRE)
    if (NEMO_BUILD_STATIC)
        nemo_set_cache_default(${_component}_BUILD_SHARED OFF BOOL "")
        nemo_set_cache_default(${_component}_BUILD_STATIC ON BOOL "")
    else ()
        nemo_set_cache_default(${_component}_BUILD_SHARED ON BOOL "")
        nemo_set_cache_default(${_component}_BUILD_STATIC OFF BOOL "")
    endif ()
    nemo_set_cache_default(${_component}_INSTALL ON BOOL "")
    set(_nemo_component_tests ${NEMO_BUILD_TESTS})
    if (_component STREQUAL "CKRE" AND NOT _NEMO_WITH_RENDER_ENGINE)
        set(_nemo_component_tests OFF)
    endif ()
    nemo_set_cache_default(${_component}_BUILD_TESTS ${_nemo_component_tests} BOOL "")
endforeach ()

if (NEMO_BUILD_STATIC)
    nemo_set_cache_default(CKBB_BUILD_SHARED OFF BOOL "")
    nemo_set_cache_default(CKBB_BUILD_STATIC ON BOOL "")
    nemo_set_cache_default(CKPLUGINS_BUILD_SHARED OFF BOOL "")
    nemo_set_cache_default(CKPLUGINS_BUILD_STATIC ON BOOL "")
    foreach (_mgr IN ITEMS SDLINPUT SDLSOUND CKPARAMOP)
        nemo_set_cache_default(${_mgr}_BUILD_SHARED OFF BOOL "")
        nemo_set_cache_default(${_mgr}_BUILD_STATIC ON BOOL "")
    endforeach ()
else ()
    nemo_set_cache_default(CKBB_BUILD_SHARED ON BOOL "")
    nemo_set_cache_default(CKBB_BUILD_STATIC OFF BOOL "")
    nemo_set_cache_default(CKPLUGINS_BUILD_SHARED ON BOOL "")
    foreach (_mgr IN ITEMS SDLINPUT SDLSOUND CKPARAMOP)
        nemo_set_cache_default(${_mgr}_BUILD_SHARED ON BOOL "")
    endforeach ()
endif ()
nemo_set_cache_default(CKBB_INSTALL ON BOOL "")
set(_nemo_bb_tests ${NEMO_BUILD_TESTS})
if (NOT _NEMO_WITH_BUILDING_BLOCKS)
    set(_nemo_bb_tests OFF)
endif ()
nemo_set_cache_default(CKBB_BUILD_TESTS ${_nemo_bb_tests} BOOL "")
if (NEMO_MODULE_SELECTION_EXPLICIT AND _NEMO_WITH_BUILDING_BLOCKS AND CKBB_BUILD_TESTS)
    foreach (_module IN LISTS CKBB_TEST_MODULES)
        set(_nemo_test_module "${_module}")
        if (_module STREQUAL "Materials-Textures")
            set(_nemo_test_module Materials)
        endif ()
        if (NOT _nemo_test_module IN_LIST NEMO_SELECTED_MODULES)
            message(FATAL_ERROR "CKBB_TEST_MODULES requests '${_module}', which NEMO_MODULES excludes")
        endif ()
    endforeach ()
endif ()
set(_nemo_paramop_tests ${NEMO_BUILD_TESTS})
if (NEMO_MODULE_SELECTION_EXPLICIT AND NOT "ParameterOperations" IN_LIST NEMO_SELECTED_MODULES)
    set(_nemo_paramop_tests OFF)
endif ()
nemo_set_cache_default(CKPARAMOP_BUILD_TESTS ${_nemo_paramop_tests} BOOL "")

include(NeMo2TestDependencies)
nemo_bb_test_dependencies(_nemo_bb_test_dependencies)
if ("renderengine" IN_LIST _nemo_bb_test_dependencies AND NOT _NEMO_WITH_RENDER_ENGINE)
    # Selected BB tests use the renderer's private static implementation. Keep
    # this test dependency separate from the optional GPU rasterizer.
    set(_NEMO_WITH_RENDER_ENGINE ON)
    set(CKRE_BUILD_SHARED OFF)
    list(APPEND NEMO_SELECTED_MODULES CK2_3D)
endif ()
if ("renderengine" IN_LIST _nemo_bb_test_dependencies AND NOT CKRE_BUILD_STATIC)
    message(STATUS "[NeMo2] Enabling CKRE_BUILD_STATIC for selected BB tests")
    set(CKRE_BUILD_STATIC ON CACHE BOOL "Build static library" FORCE)
endif ()

# Internal engine and physics tests need CK2's unexported APIs and globals.
# Choose that dependency before Source/ adds CK2 and the render engine.
if ((CK2_BUILD_TESTS OR (_NEMO_WITH_RENDER_ENGINE AND CKRE_BUILD_TESTS) OR "ck2" IN_LIST _nemo_bb_test_dependencies) AND NOT CK2_BUILD_STATIC)
    message(STATUS "[NeMo2] Enabling CK2_BUILD_STATIC for module tests")
    set(CK2_BUILD_STATIC ON CACHE BOOL "Build CK2 as a static library" FORCE)
endif ()

nemo_set_cache_default(CKPLUGINS_INSTALL ON BOOL "")
set(_nemo_plugin_tests ${NEMO_BUILD_TESTS})
if (NOT _NEMO_WITH_PLUGINS)
    set(_nemo_plugin_tests OFF)
endif ()
nemo_set_cache_default(CKPLUGINS_BUILD_TESTS ${_nemo_plugin_tests} BOOL "")
if (NEMO_MODULE_SELECTION_EXPLICIT AND _NEMO_WITH_PLUGINS AND CKPLUGINS_BUILD_TESTS)
    foreach (_module IN LISTS CKPLUGINS_TEST_MODULES)
        if (NOT _module IN_LIST NEMO_SELECTED_MODULES)
            message(FATAL_ERROR "CKPLUGINS_TEST_MODULES requests '${_module}', which NEMO_MODULES excludes")
        endif ()
    endforeach ()
endif ()

foreach (_mgr IN ITEMS SDLINPUT SDLSOUND CKPARAMOP)
    nemo_set_cache_default(${_mgr}_INSTALL ON BOOL "")
endforeach ()

if (NOT WIN32)
    nemo_set_cache_default(CKBB_BUILD_MidiManager OFF BOOL "")
endif ()
