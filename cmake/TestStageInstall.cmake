cmake_minimum_required(VERSION 3.25)

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef test_id)
set(fixture "${TEST_BINARY_DIR}/stage-install-${test_id}")
file(MAKE_DIRECTORY "${fixture}/source")
file(TO_CMAKE_PATH "${TEST_SOURCE_DIR}/cmake/NeMo2Stage.cmake" stage_script)
file(WRITE "${fixture}/source/CMakeLists.txt"
"cmake_minimum_required(VERSION 3.25)
project(EngineStageDependencies NONE)
set(CMAKE_INSTALL_PREFIX \"\${CMAKE_BINARY_DIR}/stage\")
file(WRITE \"\${CMAKE_BINARY_DIR}/components.cmake\" \"set(NEMO_RUNTIME_TARGETS Core)\\n\")
set_property(GLOBAL PROPERTY NEMO_RUNTIME_COMPONENT_MANIFEST \"\${CMAKE_BINARY_DIR}/components.cmake\")
add_custom_target(Core COMMAND \"\${CMAKE_COMMAND}\" -E touch \"\${CMAKE_BINARY_DIR}/core.runtime\")
install(FILES \"\${CMAKE_BINARY_DIR}/core.runtime\" DESTINATION Bin COMPONENT Runtime)
add_custom_target(ckre_scene_capture COMMAND \"\${CMAKE_COMMAND}\" -E touch \"\${CMAKE_BINARY_DIR}/scene.tool\")
install(FILES \"\${CMAKE_BINARY_DIR}/scene.tool\" DESTINATION tools COMPONENT Development)
include(\"${stage_script}\")
")
set(configure "${CMAKE_COMMAND}" -S "${fixture}/source" -B "${fixture}/build"
        -G "${TEST_GENERATOR}")
if (TEST_PLATFORM)
    list(APPEND configure -A "${TEST_PLATFORM}")
endif ()
if (TEST_TOOLSET)
    list(APPEND configure -T "${TEST_TOOLSET}")
endif ()
execute_process(COMMAND ${configure}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Stage fixture configure failed:\n${output}${error}")
endif ()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --config Release --target stage
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${fixture}/build.log" "${output}${error}")
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Stage did not build its install inputs:\n${output}${error}")
endif ()
if (NOT EXISTS "${fixture}/build/stage/Bin/core.runtime" OR
        NOT EXISTS "${fixture}/build/stage/tools/scene.tool")
    message(FATAL_ERROR "Stage omitted a runtime or development artifact")
endif ()
message(STATUS "Stage built and installed its runtime and development inputs")
