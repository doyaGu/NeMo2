cmake_minimum_required(VERSION 3.25)

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef test_id)
set(fixture "${TEST_BINARY_DIR}/stage-install-${test_id}")
file(MAKE_DIRECTORY "${fixture}/source")
file(TO_CMAKE_PATH "${TEST_SOURCE_DIR}/cmake/NeMo2Stage.cmake" stage_script)
file(WRITE "${fixture}/source/CMakeLists.txt"
"cmake_minimum_required(VERSION 3.25)
project(EngineStageDependencies NONE)
set(CMAKE_INSTALL_PREFIX \"${fixture}/external\")
file(WRITE \"\${CMAKE_BINARY_DIR}/components.cmake\" \"set(NEMO_RUNTIME_TARGETS Core)\\n\")
set_property(GLOBAL PROPERTY NEMO_RUNTIME_COMPONENT_MANIFEST \"\${CMAKE_BINARY_DIR}/components.cmake\")
option(WITH_OPTIONAL \"\" ON)
option(FAIL_INSTALL \"\" OFF)
if(WITH_OPTIONAL)
    file(WRITE \"\${CMAKE_BINARY_DIR}/optional.runtime\" \"old\")
    install(FILES \"\${CMAKE_BINARY_DIR}/optional.runtime\" DESTINATION Bin COMPONENT Runtime)
endif()
if(FAIL_INSTALL)
    install(FILES \"\${CMAKE_BINARY_DIR}/missing.runtime\" DESTINATION Bin COMPONENT Runtime)
endif()
add_custom_target(Core COMMAND \"\${CMAKE_COMMAND}\" -E touch \"\${CMAKE_BINARY_DIR}/core.runtime\")
install(FILES \"\${CMAKE_BINARY_DIR}/core.runtime\" DESTINATION Bin COMPONENT Runtime)
add_custom_target(ckre_scene_capture COMMAND \"\${CMAKE_COMMAND}\" -E touch \"\${CMAKE_BINARY_DIR}/scene.tool\")
install(FILES \"\${CMAKE_BINARY_DIR}/scene.tool\" DESTINATION tools COMPONENT Development)
# Test dependencies can register install rules before their libraries are built.
install(FILES \"\${CMAKE_BINARY_DIR}/unbuilt-gmock.lib\" DESTINATION lib COMPONENT gmock)
include(\"${stage_script}\")
")
set(configure "${CMAKE_COMMAND}" -S "${fixture}/source" -B "${fixture}/build"
        -G "${TEST_GENERATOR}" "-DCMAKE_INSTALL_PREFIX=${fixture}/external")
if (TEST_PLATFORM)
    list(APPEND configure -A "${TEST_PLATFORM}")
endif ()
if (TEST_TOOLSET)
    list(APPEND configure -T "${TEST_TOOLSET}")
endif ()
execute_process(COMMAND ${configure}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Stage fixture configure failed:\n${output}${error}")
endif ()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --config Release --target stage
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${fixture}/build.log" "${output}${error}")
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Stage did not build its install inputs:\n${output}${error}")
endif ()
if (NOT EXISTS "${fixture}/build/stage/Bin/core.runtime" OR
        NOT EXISTS "${fixture}/build/stage/tools/scene.tool")
    message(FATAL_ERROR "Stage omitted a runtime or development artifact")
endif ()
if (EXISTS "${fixture}/build/stage/lib/unbuilt-gmock.lib")
    message(FATAL_ERROR "Stage installed a test-only dependency")
endif ()
message(STATUS "Stage built and installed its runtime and development inputs")

if (NOT EXISTS "${fixture}/build/stage/Bin/optional.runtime")
    message(FATAL_ERROR "Initial stage omitted optional module")
endif ()
file(MAKE_DIRECTORY "${fixture}/external")
file(WRITE "${fixture}/external/keep" "user data")
execute_process(COMMAND ${configure} -DWITH_OPTIONAL=OFF
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Stage reconfigure failed: ${output}${error}")
endif ()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --config Release --target stage
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT result EQUAL 0 OR EXISTS "${fixture}/build/stage/Bin/optional.runtime" OR
        NOT EXISTS "${fixture}/build/stage/Bin/core.runtime")
    message(FATAL_ERROR "Stage retained an old combination or lost a current artifact: ${output}${error}")
endif ()
if (NOT EXISTS "${fixture}/external/keep" OR EXISTS "${fixture}/external/Bin")
    message(FATAL_ERROR "Stage modified the custom install prefix")
endif ()
file(WRITE "${fixture}/build/stage/previous" "preserve on failure")
execute_process(COMMAND ${configure} -DFAIL_INSTALL=ON
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Failure fixture configure failed: ${output}${error}")
endif ()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --config Release --target stage
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if (result EQUAL 0 OR NOT EXISTS "${fixture}/build/stage/previous" OR
        NOT EXISTS "${fixture}/build/stage/Bin/core.runtime")
    message(FATAL_ERROR "A failed install did not preserve the previous stage: ${output}${error}")
endif ()
message(STATUS "Stage replaced the selected combination and preserved user files and failed-install state")

file(REMOVE_RECURSE "${fixture}/build/stage")
file(CREATE_LINK "${fixture}/external" "${fixture}/build/stage" SYMBOLIC RESULT link_result)
if (link_result STREQUAL "0")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DNEMO_STAGE_BUILD_DIR=${fixture}/build"
            -DNEMO_STAGE_CONFIG=Release -P "${TEST_SOURCE_DIR}/cmake/NeMo2StageInstall.cmake"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (result EQUAL 0 OR NOT IS_SYMLINK "${fixture}/build/stage" OR
            NOT EXISTS "${fixture}/external/keep")
        message(FATAL_ERROR "Stage followed or removed a symlink destination: ${output}${error}")
    endif ()
endif ()
